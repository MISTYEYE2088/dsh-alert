{
  "name": "dsh-alert",
  "version": "0.2.0",
  "description": "DeepSeek Harness web plugin: system notification and sound when an agent round or a context compaction finishes or fails.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MISTYEYE2088/dsh-alert.git"
  },
  "bugs": {
    "url": "https://github.com/MISTYEYE2088/dsh-alert/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tools/smoke.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "alert"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
