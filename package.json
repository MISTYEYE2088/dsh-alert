{
  "name": "dsh-alert",
  "version": "0.3.0",
  "description": "DeepSeek Harness plugin: a desktop notification and a sound when an agent round or a context compaction finishes or fails. Raised by the Harness process, so it does not depend on a browser tab.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MISTYEYE2088/dsh-alert.git"
  },
  "bugs": {
    "url": "https://github.com/MISTYEYE2088/dsh-alert/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./notifier": "./notifier.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "notifier.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tools/smoke.mjs",
    "test:boot": "node tools/boot-check.mjs",
    "test:os": "node tools/probe-os.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "alert",
    "toast"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
